# Spatial understanding / agent reasoning
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# Enable only after a successful server-side canary against the configured model.
ENABLE_LIVE_OPENAI=false
# Record the genuine response ID from that canary in deployment secrets/release evidence.
OPENAI_CANARY_RESPONSE_ID=

# Deadline experience flags
NEXT_PUBLIC_ENABLE_PAIRED_EXPERIENCE=true
NEXT_PUBLIC_ENABLE_CONCEPT_RENDER=false
NEXT_PUBLIC_ENABLE_PHONE_3D_PREVIEW=false

# Supabase real-device pairing. The publishable key is browser-safe; the secret key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SESSION_TOKEN_PEPPER=
SESSION_CLEANUP_SECRET=

# Voice refinement (private server-side values)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Optional generated concept renders (Nano Banana / Gemini image)
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_ANALYSIS_MODEL=gemini-3.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Public deployment origin, for example https://interiorin.example
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional build-time component discovery; never exposed to the browser
API_KEY_21ST=
